# Public, non-secret settings only. Never put secret API keys in VITE_ variables —
# everything prefixed with VITE_ is bundled into the frontend and visible to users.

# Currency used to display menu prices (ISO 4217 code) and the locale for formatting
VITE_CURRENCY=USD
VITE_LOCALE=en-US

# Pricing rules (in the currency above)
VITE_DELIVERY_FEE=3.99
VITE_FREE_DELIVERY_THRESHOLD=40
VITE_TAX_RATE=0.08

# Set to "true" to show the online payment option at checkout.
# This is a demo placeholder; a real payment provider must be integrated server-side.
VITE_ONLINE_PAYMENT_ENABLED=false
VITE_ONLINE_PAYMENT_LABEL=Pay Online (Stripe)

# Restaurant contact
VITE_WHATSAPP_NUMBER=15551234567
